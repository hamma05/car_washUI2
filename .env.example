# Local development only (NOT used on Render — set these in the Render dashboard).
# Copy this file to ".env" for local work.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-key-change-me

# Render hosts this app serves:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
